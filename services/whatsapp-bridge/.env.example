# Copy to .env and fill in before running `node index.js` locally.
# On Railway, set these as service Variables instead — this file is only
# for local development (never commit a filled-in .env).

# Required — the Firebase service account JSON for the SAME Firebase
# project the dashboard (app/leo-ui) uses, pasted as a single-line string.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key -> paste the whole downloaded file's contents here.
FIREBASE_SERVICE_ACCOUNT=

# Required for LEO to turn WhatsApp "open <page>" style commands and
# document/image replies into real links back to the dashboard — the
# dashboard's own deployed URL, e.g. https://leo.smartlabs.lk
LEO_WEB_BASE_URL=

# Optional — a WhatsApp JID (e.g. 94771234567@s.whatsapp.net) to receive
# the opt-in daily ops digest and scheduled-message failure alerts. Leave
# unset to disable both.
DAILY_DIGEST_JID=

# Optional — where Baileys stores its WhatsApp "linked device" session
# files. Defaults to ./auth_info. On Railway, point this at a mounted
# volume (e.g. /app/auth_info) so a redeploy doesn't force re-linking.
AUTH_DIR=

# Optional — defaults to 330 (Sri Lanka, UTC+5:30). Only change this if
# LEO's reminders/scheduling should be parsed in a different timezone.
REMINDER_TZ_OFFSET_MINUTES=

# Optional — pino log level (e.g. "info", "debug", "warn"). Defaults to
# a sensible built-in level if unset.
LOG_LEVEL=

# Optional — enables the LMS integration (student approvals, etc.). Both
# must be set together; leave both unset to disable it entirely.
LMS_BASE_URL=
LMS_API_KEY=

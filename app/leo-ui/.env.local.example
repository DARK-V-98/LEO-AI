# Copy to .env.local and fill in with your SmartLabs Firebase project's
# Web App config (Firebase console -> Project settings -> Your apps -> SDK
# setup and configuration). Until these are set, LEO falls back to storing
# voice profiles (and later, tasks/leads) in browser localStorage only.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI providers (server-side only — used by the /api/* routes, never
# sent to the browser) ------------------------------------------------------

# Google AI Studio key — used for Gemini calls (chat, essay/speaking
# scoring, image generation).
GEMINI_API_KEY=

# Optional — caps how many Gemini calls LEO will make per day before
# falling back to OpenRouter, so a traffic spike can't blow through a free
# quota unnoticed. Leave unset to use the code's built-in default.
GEMINI_DAILY_CALL_BUDGET=

# OpenRouter key — fallback/alternate model provider.
OPENROUTER_API_KEY=

# Copy to .env.local and fill in with your SmartLabs Firebase project's
# Web App config (Firebase console -> Project settings -> Your apps -> SDK
# setup and configuration). Until these are set, LEO falls back to storing
# voice profiles (and later, tasks/leads) in browser localStorage only.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
